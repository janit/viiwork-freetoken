# A native systemd unit, which is the recommended shape for this node.
#
# The Dockerfile in the repo root works, but FreeToken is an edge-native engine:
# it wants host RAM, a fast PCIe link and a persistent JIT kernel cache, and a
# container adds a large image and a set of volume mounts to get back to where
# a native install already is. Containerise this only if the rest of your fleet
# is containerised.
#
# Copy to /etc/systemd/system/viiwork-freetoken.service and edit the three
# paths. Then:
#
#     systemctl daemon-reload
#     systemctl enable --now viiwork-freetoken
#     journalctl -fu viiwork-freetoken

[Unit]
Description=viiwork-freetoken mesh node (DeepSeek-V4-Flash)
After=network-online.target
Wants=network-online.target

# Give up after three failed starts in an hour rather than reloading a model
# that cannot load, forever. See the Restart= comment below for why the systemd
# defaults do not achieve this on their own.
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=simple
User=viiwork
Group=viiwork

# nvcc must be on PATH at RUN time, not just at install time: FreeToken
# JIT-compiles its CUDA kernels on first use. A unit that works interactively
# and fails under systemd is almost always this line missing.
Environment=PATH=/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CUDA_HOME=/usr/local/cuda
Environment=LD_LIBRARY_PATH=/usr/local/cuda/lib64

# HOME is load bearing, and quietly so. `ft bench bw` writes its profile under
# $HOME/.cache/freetoken, and that profile is the ONLY thing that makes
# --moe-backend auto resolve to `hybrid` instead of `offload`. Point HOME
# somewhere the profile is not and the node serves the slower backend forever,
# with nothing in the log to say why. The JIT kernel cache lives beside it, so
# the same mistake also recompiles kernels on every start.
#
# Point it at the home the profile was benched in.
Environment=HOME=/home/viiwork

ExecStart=/usr/local/bin/viiwork-freetoken --config /etc/viiwork/viiwork-freetoken.yaml

# For the ENGINE, not for the node. The node is a Go process that spawns `ft`
# and inherits these to it; the engine pins host memory to stage expert weights
# for the offload/hybrid backends, and a default 8 MB memlock ceiling turns that
# into a failure minutes into a load. Carried from a working bare-engine unit.
LimitMEMLOCK=infinity
LimitNOFILE=65535

# The node stops accepting first, then stops its backends, so a request in
# flight finishes against a live engine. Give it room: 60s of shutdown_grace
# plus the node's own 30s drain.
KillSignal=SIGTERM
TimeoutStopSec=180

# A model that cannot load will never load. The node's own max_respawns bounds
# the inner loop; StartLimitBurst in [Unit] bounds the outer one.
#
# The limit is not optional and the defaults do not provide it: systemd ships
# StartLimitIntervalSec=10s with StartLimitBurst=5, and at RestartSec=30s you
# can never fit five starts into a ten-second window, so the rate limiter never
# trips and a hopeless model reloads forever. Observed: a checkpoint whose dense
# weights exceed the card OOMs inside load_state_dict every time, and each
# attempt re-reads the whole checkpoint first.
Restart=on-failure
RestartSec=30s

# Memory is the constraint that bites on an offload MoE backend — the weights
# live in host RAM. Do NOT set MemoryMax here unless you have measured the
# steady-state footprint: the OOM killer arriving 18 minutes into a load is a
# slow way to learn the number. Protect the rest of the box instead.
OOMScoreAdjust=200

[Install]
WantedBy=multi-user.target
